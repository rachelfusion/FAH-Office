# Copy this file to .env (never commit .env) and fill it in.
# Turn on Developer Mode in Discord (Settings > Advanced) to copy IDs with right-click.

# Bot token from https://discord.com/developers/applications > your app > Bot > Reset Token
DISCORD_TOKEN=

# Right-click your server icon > Copy Server ID
GUILD_ID=

# Right-click the voice channel > Copy Channel ID
VOICE_CHANNEL_ID=

# Your crew: right-click each person > Copy User ID. Comma-separated, max 4 (one per bunk).
CREW_USER_IDS=

# Music bots to show at the DJ decks. Comma-separated, max 2.
MUSIC_BOT_IDS=

# Any long random string. Must be the SAME value as LIVE_SECRET on Vercel.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIVE_SECRET=

# The office website, used for the "Open the office" button.
OFFICE_URL=https://fah-office.vercel.app

# Optional: a text channel for the live office board (right-click the channel > Copy Channel ID).
# The bot posts one message there and keeps it up to date. Pin it!
BOARD_CHANNEL_ID=

# Optional: only let your site connect, e.g. https://fah-office.vercel.app
ALLOWED_ORIGINS=

# Railway/Fly/Render set this for you.
PORT=8080
