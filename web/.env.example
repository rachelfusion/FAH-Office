# Set these in Vercel > Project > Settings > Environment Variables.
# For local testing with `npx vercel dev`, copy to .env.local (never commit it).

# From https://discord.com/developers/applications > your app > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your site's address, e.g. https://fah-office.vercel.app (no trailing slash).
# Also add  <PUBLIC_URL>/api/auth/callback  as a Redirect in Discord > OAuth2.
PUBLIC_URL=

# Same comma-separated user IDs as the bot. Only these people can see the live office.
CREW_USER_IDS=

# Where the bot runs, as a WebSocket address, e.g. wss://fah-office-bot.up.railway.app
BOT_LIVE_URL=

# Long random strings. LIVE_SECRET must match the bot's. SESSION_SECRET is only for Vercel.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIVE_SECRET=
SESSION_SECRET=

# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
